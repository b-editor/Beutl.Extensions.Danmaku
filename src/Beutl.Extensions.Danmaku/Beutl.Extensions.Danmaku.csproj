<Project Sdk="Beutl.Extensibility.Sdk/2.0.0-preview.13">

    <PropertyGroup>
        <PackageId>Beutl.Extensions.Danmaku</PackageId>
        <Title>Danmaku</Title>
        <Description>Import, download and edit comments that scroll across the screen.</Description>
        <NeutralLanguage>en</NeutralLanguage>
        <PackageTags>caption,comment,danmaku,弾幕,コメント</PackageTags>
        <Version>0.1.5</Version>
        <AssemblyVersion>0.1.5.0</AssemblyVersion>
        <Authors>Yuto Terada</Authors>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageIcon>icon.png</PackageIcon>
        <BeutlAutoReferenceSourceGenerators>false</BeutlAutoReferenceSourceGenerators>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference
            Include="Beutl.Engine.SourceGenerators"
            OutputItemType="Analyzer"
            ReferenceOutputAssembly="false"
            Version="2.0.0-preview.13"
            PrivateAssets="all" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Beutl.Extensions.Danmaku.Tests" />
    </ItemGroup>

    <ItemGroup>
        <EmbeddedResource Update="Properties/Strings.resx">
            <StronglyTypedLanguage>C#</StronglyTypedLanguage>
            <StronglyTypedNamespace>Beutl.Extensions.Danmaku.Properties</StronglyTypedNamespace>
            <StronglyTypedClassName>Strings</StronglyTypedClassName>
            <StronglyTypedFileName>$(IntermediateOutputPath)Strings.g.cs</StronglyTypedFileName>
            <PublicClass>true</PublicClass>
        </EmbeddedResource>
    </ItemGroup>


    <ItemGroup>
        <!-- The icons Beutl's own tool tabs use. Beutl ships them, so the SDK compiles against Beutl's version and
             leaves them out of the output and the package: at run time the extension uses Beutl's copies.
             FluentIcons.Common and FluentIcons.Resources.Avalonia come with them, at the version they pin. -->
        <BeutlHostPackageReference Include="FluentIcons.Avalonia.Fluent" />
    </ItemGroup>

    <ItemGroup>
        <None Include="..\..\assets\icon.png" Pack="true" PackagePath="\" Visible="false" />
    </ItemGroup>
</Project>
