<Project Sdk="Beutl.Extensibility.Sdk/2.0.0-preview.12">

    <PropertyGroup>
        <PackageId>Beutl.Extensions.Danmaku</PackageId>
        <Title>コメント弾幕</Title>
        <Description>コメントファイルを読み込み、画面を右から左へ流れるコメント弾幕を生成します</Description>
        <PackageTags>caption,comment,danmaku,弾幕,コメント</PackageTags>
        <Version>0.1.3</Version>
        <AssemblyVersion>0.1.3.0</AssemblyVersion>
        <Authors>Yuto Terada</Authors>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageIcon>icon.png</PackageIcon>
        <BeutlAutoReferenceSourceGenerators>false</BeutlAutoReferenceSourceGenerators>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference
            Include="Beutl.Engine.SourceGenerators"
            OutputItemType="Analyzer"
            ReferenceOutputAssembly="false"
            Version="2.0.0-preview.12"
            PrivateAssets="all" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Beutl.Extensions.Danmaku.Tests" />
    </ItemGroup>


    <ItemGroup>
        <!-- The icons Beutl's own tool tabs use. Beutl ships them, so the SDK compiles against Beutl's version and
             leaves them out of the output and the package: at run time the extension uses Beutl's copies.
             FluentIcons.Common and FluentIcons.Resources.Avalonia come with them, at the version they pin. -->
        <BeutlHostPackageReference Include="FluentIcons.Avalonia.Fluent" />
    </ItemGroup>

    <ItemGroup>
        <None Include="..\..\assets\icon.png" Pack="true" PackagePath="\" Visible="false" />
    </ItemGroup>
</Project>
