<Application x:Class="Beutl.Extensions.Danmaku.Tests.HeadlessApp"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sty="using:FluentAvalonia.Styling"
             RequestedThemeVariant="Dark">
    <!-- Use the host's compiled styles rather than recreating their resources in the tests. -->
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://Beutl.Controls/Styling/Fonts.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
    <Application.Styles>
        <sty:FluentAvaloniaTheme PreferUserAccentColor="True" TextVerticalAlignmentOverrideBehavior="Disabled" />
        <StyleInclude Source="avares://Beutl.Controls/Styles.axaml" />
    </Application.Styles>
</Application>
